# Copy to tools/release.env and fill in. That file is gitignored: it points at
# the signing key, and may hold its password.
#
# Nothing here belongs on the public server. The server only ever receives the
# static output of `fdroid deploy`.

# --- signing -----------------------------------------------------------------

# The APK signing key. F-Droid pins it on first install and it can never be
# rotated without every user reinstalling, so keep an offline backup.
SNOT_KEYSTORE="$HOME/keys/snot-release.p12"
SNOT_KEY_ALIAS="snot"

# Leave both unset to have apksigner prompt on the terminal, which is the right
# choice for a workstation. Set them only where a prompt is impossible (CI),
# and from a secret store rather than a literal.
#SNOT_KEYSTORE_PASS=""
#SNOT_KEY_PASS=""        # only if the key password differs from the store's

# --- publishing --------------------------------------------------------------

# The fdroidserver working tree: the directory holding config.yml, repo/ and
# metadata/, created by `fdroid init`.
SNOT_FDROID_DIR="$HOME/snot-fdroid"

# --- toolchain (only if the defaults are wrong) ------------------------------

#ANDROID_HOME="$HOME/Android/Sdk"
#NDK_HOME="$HOME/Android/Sdk/ndk/27.2.12479018"
